# Orquestación local D01. Sustituir marcadores al crear .env.
COMPOSE_PROJECT_NAME=homex
BACKEND_CONTEXT=../homex-backend
FRONTEND_CONTEXT=../homex-frontend
HOMEX_BACKEND_IMAGE_TAG=d02-0659dc5
HOMEX_FRONTEND_IMAGE_TAG=d02-57c32d3
BACKEND_PORT=8000
STAGING_HTTP_BIND=127.0.0.1
STAGING_HTTP_PORT=8080

# PostgreSQL: bootstrap, migrador y runtime son identidades diferentes.
POSTGRES_DB=homex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-admin-password
POSTGRES_PORT=5432
HOMEX_DB_MIGRATOR_USER=homex_migrator
HOMEX_DB_MIGRATOR_PASSWORD=replace-with-migrator-password
HOMEX_DB_RUNTIME_USER=homex_runtime
HOMEX_DB_RUNTIME_PASSWORD=replace-with-runtime-password
HOMEX_MIGRATOR_DATABASE_URL=postgresql://homex_migrator:replace-with-migrator-password@postgres:5432/homex
DATABASE_URL=postgresql://homex_runtime:replace-with-runtime-password@postgres:5432/homex

# Redis/Celery.
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0

# Contrato backend.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.integration
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:8080
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
HOMEX_AUDIO_TEMP_ROOT=/var/lib/homex/audio-temporal
HOMEX_AUDIO_MAX_BYTES=25000000
HOMEX_AUDIO_TTL_SECONDS=3600
HOMEX_OUTBOX_RECONCILE_SECONDS=3600
ASR_MODEL_SOURCE=/absolute/path/to/faster-whisper-small
HOMEX_ASR_MODEL_PATH=/opt/homex/models/faster-whisper-small
HOMEX_ASR_DEVICE=cpu
HOMEX_ASR_COMPUTE_TYPE=int8

# Media persistente — reservada para D03/producción; nunca exponer al frontend.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=homex-public-media
HOMEX_MEDIA_PUBLIC_DOMAIN=media.example.com

# Contrato de build frontend, utilizado desde D02.
VITE_API_BASE_URL=http://localhost:8080

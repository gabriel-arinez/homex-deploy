# Infraestructura local D00. Sustituir los marcadores al crear .env.
COMPOSE_PROJECT_NAME=homex
POSTGRES_DB=homex
POSTGRES_USER=homex
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Contrato del backend (homex-backend/.env.example).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.production
DATABASE_URL=postgresql://homex:replace-with-a-local-password@postgres:5432/homex
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CELERY_BROKER_URL=redis://redis:6379/0
HOMEX_AUDIO_TEMP_ROOT=/var/lib/homex/audio-temporal
HOMEX_AUDIO_MAX_BYTES=25000000
HOMEX_AUDIO_TTL_SECONDS=3600
HOMEX_OUTBOX_RECONCILE_SECONDS=3600
HOMEX_ASR_MODEL_PATH=/opt/homex/models/faster-whisper-small
HOMEX_ASR_DEVICE=cpu
HOMEX_ASR_COMPUTE_TYPE=int8

# Media persistente. Son marcadores, nunca credenciales reales.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=homex-public-media
HOMEX_MEDIA_PUBLIC_DOMAIN=media.example.com

# Contrato de build del frontend vigente desde FE02/FE03.
VITE_API_BASE_URL=http://localhost:8000

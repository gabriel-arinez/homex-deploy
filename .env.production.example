# HOMEX D04 — release candidate privada. Sustituir secretos antes de operar.
COMPOSE_PROJECT_NAME=homex-prod
BACKEND_CONTEXT=../homex-backend
FRONTEND_CONTEXT=../homex-frontend
HOMEX_BACKEND_IMAGE_TAG=d04-9ce7230
HOMEX_FRONTEND_IMAGE_TAG=d04-deba1de

# Único punto HTTP del host. cloudflared corre en el host y alcanza este listener local.
HOMEX_PRIVATE_HOSTNAME=homex.internal
HOMEX_PRIVATE_ORIGIN=https://homex.internal
HOMEX_PRIVATE_BIND=127.0.0.1
HOMEX_PRIVATE_PORT=443

# PostgreSQL: bootstrap, migrador y runtime separados.
POSTGRES_DB=homex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-admin-password
HOMEX_DB_MIGRATOR_USER=homex_migrator
HOMEX_DB_MIGRATOR_PASSWORD=replace-with-migrator-password
HOMEX_DB_RUNTIME_USER=homex_runtime
HOMEX_DB_RUNTIME_PASSWORD=replace-with-runtime-password
HOMEX_MIGRATOR_DATABASE_URL=postgresql://homex_migrator:replace-with-migrator-password@postgres:5432/homex
DATABASE_URL=postgresql://homex_runtime:replace-with-runtime-password@postgres:5432/homex

# Backend / mismo origen privado.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=homex.internal,localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=https://homex.internal
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
CELERY_BROKER_URL=redis://redis:6379/0

# TLS interno: necesario para que navegador/móvil disponga de contexto seguro (micrófono).
HOMEX_TLS_CERT_HOST_PATH=/etc/homex/tls/homex.internal.crt
HOMEX_TLS_KEY_HOST_PATH=/etc/homex/tls/homex.internal.key
HOMEX_CA_CERT_HOST_PATH=/etc/homex/tls/homex-root-ca.crt

# Media productiva local.
HOMEX_MEDIA_STORAGE=filesystem
HOMEX_MEDIA_HOST_PATH=/srv/homex/media
HOMEX_MEDIA_UID=10001
HOMEX_MEDIA_GID=10001
HOMEX_MEDIA_ROOT=/var/lib/homex/media
HOMEX_MEDIA_URL=/media/
HOMEX_HTTPS_ENABLED=1

# Audio ASR efímero.
HOMEX_AUDIO_TEMP_ROOT=/var/lib/homex/audio-temporal
HOMEX_AUDIO_MAX_BYTES=25000000
HOMEX_AUDIO_TTL_SECONDS=3600
HOMEX_OUTBOX_RECONCILE_SECONDS=3600
ASR_MODEL_SOURCE=/absolute/path/to/faster-whisper-small
HOMEX_ASR_MODEL_PATH=/opt/homex/models/faster-whisper-small
HOMEX_ASR_DEVICE=cpu
HOMEX_ASR_COMPUTE_TYPE=int8

# Recuperación: almacenamiento fuera del árbol de media y retención local inicial.
HOMEX_BACKUP_ROOT=/srv/homex/backups
HOMEX_BACKUP_RETENTION_DAYS=14

# Frontend: mismo origen que el hostname privado de Cloudflare One.
VITE_API_BASE_URL=https://homex.internal

# Límites iniciales; ajustar sólo con métricas reales.
HOMEX_POSTGRES_CPUS=1.5
HOMEX_POSTGRES_MEMORY=2g
HOMEX_REDIS_CPUS=0.5
HOMEX_REDIS_MEMORY=256m
HOMEX_API_CPUS=1.0
HOMEX_API_MEMORY=1g
HOMEX_WORKER_CPUS=2.0
HOMEX_WORKER_MEMORY=3g
HOMEX_PROXY_CPUS=0.5
HOMEX_PROXY_MEMORY=256m

# Cloudflare Tunnel: el token real se guarda fuera de Git.
CLOUDFLARED_VERSION=2026.9.2
CLOUDFLARED_AMD64_SHA256=ea2c9bb2d5017a796b64bf36e605d727accf76a5500014bb12952ce11ae1f932
CLOUDFLARED_ARM64_SHA256=39f23e7c55ce2c2e502a0b3e070b978bf69135b19246b5b7581dadb94cf2144d
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/homex/cloudflared/tunnel-token

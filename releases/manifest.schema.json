{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homex.local/schemas/release-manifest-v1.json",
  "title": "HOMEX release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "sources",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "created_at",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "baseline",
            "candidate",
            "released",
            "superseded"
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "frontend",
        "nlp"
      ],
      "properties": {
        "backend": {
          "$ref": "#/$defs/source"
        },
        "frontend": {
          "$ref": "#/$defs/source"
        },
        "nlp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "package_version",
            "artifact",
            "sha256"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "$ref": "#/$defs/sha"
            },
            "package_version": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asr_model",
        "images",
        "postgresql",
        "redis",
        "expected_migrations"
      ],
      "properties": {
        "asr_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "const": "pending-d01"
                }
              ]
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api",
            "worker",
            "frontend_proxy"
          ],
          "properties": {
            "api": {
              "$ref": "#/$defs/image"
            },
            "worker": {
              "$ref": "#/$defs/image"
            },
            "frontend_proxy": {
              "$ref": "#/$defs/image"
            }
          }
        },
        "postgresql": {
          "type": "string",
          "minLength": 1
        },
        "redis": {
          "type": "string",
          "minLength": 1
        },
        "expected_migrations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d{4}_[a-z0-9_]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release": {
            "properties": {
              "status": {
                "not": {
                  "const": "baseline"
                }
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "release"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "asr_model": {
                "properties": {
                  "version": {
                    "not": {
                      "pattern": "^pending-"
                    }
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              },
              "images": {
                "properties": {
                  "api": {
                    "$ref": "#/$defs/release_image"
                  },
                  "worker": {
                    "$ref": "#/$defs/release_image"
                  },
                  "frontend_proxy": {
                    "$ref": "#/$defs/release_image"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release": {
            "properties": {
              "status": {
                "const": "released"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "release"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "images": {
                "properties": {
                  "api": {
                    "$ref": "#/$defs/digested_image"
                  },
                  "worker": {
                    "$ref": "#/$defs/digested_image"
                  },
                  "frontend_proxy": {
                    "$ref": "#/$defs/digested_image"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "pattern": "^(pending-d0[12]|.+:[^:@\\s]+(?:@sha256:[0-9a-f]{64})?)$"
    },
    "release_image": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^.+:[^:@\\s]+@sha256:[0-9a-f]{64}$"
        },
        {
          "type": "string",
          "pattern": "^.+:d[0-9]{2}-[0-9a-f]{7}$"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "digested_image": {
      "type": "string",
      "pattern": "^.+:[^:@\\s]+@sha256:[0-9a-f]{64}$"
    }
  }
}

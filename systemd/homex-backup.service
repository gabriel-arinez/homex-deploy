[Unit]
Description=HOMEX - backup D05 local y copia cifrada Restic R2
Wants=docker.service network-online.target
After=docker.service network-online.target
RequiresMountsFor=/srv/homex/backups
ConditionPathExists=/home/gabriel/HOMEX/homex-deploy/.env.production
ConditionPathIsDirectory=/srv/homex/media

[Service]
Type=oneshot
User=gabriel
Group=gabriel
WorkingDirectory=/home/gabriel/HOMEX/homex-deploy
Environment=HOME=/home/gabriel
Environment=COMPOSE_PROJECT_NAME=homex-prod
Environment=HOMEX_ENV_FILE=.env.production
Environment=HOMEX_MEDIA_HOST_PATH=/srv/homex/media
Environment=HOMEX_BACKUP_ROOT=/srv/homex/backups
Environment=HOMEX_BACKUP_RETENTION_DAYS=14
Environment=HOMEX_RESTIC_CONFIG=/home/gabriel/.config/homex/restic-r2.env
Environment=RESTIC_PASSWORD_FILE=/home/gabriel/.config/homex/restic-password
Environment=RESTIC_CACHE_DIR=/srv/homex/backups/.restic-cache
UMask=0077
ExecStart=/bin/sh /home/gabriel/HOMEX/homex-deploy/scripts/backup_and_offsite.sh
TimeoutStartSec=60min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/homex/backups
StandardOutput=journal
StandardError=journal
